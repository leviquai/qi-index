# Copy to .env and adjust as needed. docker-compose.yml reads this file
# automatically.

# --- Postgres (used by the qi-index and postgres services) ---
POSTGRES_USER=qi_index
POSTGRES_PASSWORD=qi_index
POSTGRES_DB=qi_index
POSTGRES_PORT=5432

# --- qi-index follow ---
QI_RPC_URL=https://rpc.quai.network/cyprus1
QI_WS_URL=wss://rpc.quai.network/cyprus1
QI_METRICS_ADDR=:2112
QI_API_ADDR=:8080
QI_VERBOSE=false
METRICS_PORT=2112
API_PORT=8080
